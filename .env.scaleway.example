# Copy to .env.scaleway (gitignored) and fill in. `scw init` can supply the
# SCW_* values instead if you prefer the CLI config file.

# SCW_DEFAULT_REGION=fr-par
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_PROJECT_ID=

MAILINER_AUTH=paseto
MAILINER_PASETO_SECRET=                  # exactly 32 bytes
METRICS_AUTH_TOKEN=
# MAILINER_ALLOWED_ORIGINS=https://app.mailiner.net
# MAILINER_ALLOWED_HOSTS=

# SCALEWAY_REGISTRY_NS=mailiner-ws-tcp-proxy
# SCALEWAY_CONTAINER_NS=mailiner-dev
# SCALEWAY_CONTAINER_NAME=ws-tcp-proxy
# SCALEWAY_MIN_SCALE=1
# SCALEWAY_MAX_SCALE=1
# SCALEWAY_MEMORY_MB=256
# SCALEWAY_CPU_MVCPU=140
